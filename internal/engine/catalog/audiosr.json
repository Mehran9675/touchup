{
  "id": "audiosr",
  "name": "AudioSR",
  "vendor": "Haohe Liu et al.",
  "description": "Diffusion-based audio super-resolution. Rebuilds the missing high frequencies of music, speech and effects and outputs 48 kHz.",
  "homepage": "https://github.com/haoheliu/versatile_audio_super_resolution",
  "license": "MIT",
  "tags": ["Diffusion", "Music", "Speech", "Python"],
  "requirements": "Python 3.9–3.11 · NVIDIA GPU recommended · about 6 GB with models",
  "media": ["audio"],
  "input": "audio",
  "install": {"type": "pip", "packages": ["audiosr==0.0.7"], "size": "≈6 GB with PyTorch"},
  "executable": {"*": "audiosr"},
  "args": ["-i", "{input}", "-s", "{outputDir}", "{modelArgs}", "--ddim_steps", "50", "-gs", "3.5", "-d", "auto"],
  "outputExt": ".wav",
  "models": [
    {"id": "basic", "name": "General", "description": "Music, effects and mixed content.", "args": ["--model_name", "basic"]},
    {"id": "speech", "name": "Speech", "description": "Tuned for voice recordings.", "args": ["--model_name", "speech"]}
  ]
}
