{
  "id": "audiosr",
  "name": "AudioSR",
  "featured": true,
  "vendor": "Haohe Liu et al.",
  "description": "Diffusion-based audio super-resolution. Rebuilds the missing high frequencies of music, speech and effects and outputs 48 kHz.",
  "homepage": "https://github.com/haoheliu/versatile_audio_super_resolution",
  "license": "MIT",
  "tags": ["Diffusion", "Music", "Speech", "Python"],
  "requirements": "Python 3.9–3.11 · NVIDIA GPU recommended · about 6 GB with models",
  "media": ["audio"],
  "input": "audio",
  "install": {"type": "pip", "packages": ["audiosr==0.0.7"], "size": "≈6 GB with PyTorch"},
  "executable": {"*": "audiosr"},
  "args": ["-i", "{input}", "-s", "{outputDir}", "{modelArgs}", "-d", "auto"],
  "outputExt": ".wav",
  "models": [
    {"id": "basic", "name": "General", "description": "Music, effects and mixed content.", "args": ["--model_name", "basic"]},
    {"id": "speech", "name": "Speech", "description": "Tuned for voice recordings.", "args": ["--model_name", "speech"]}
  ],
  "options": [
    {
      "id": "steps",
      "name": "Diffusion steps",
      "type": "choice",
      "default": "50",
      "description": "More steps can add finer detail; fewer are proportionally faster.",
      "choices": [
        {"value": "25", "label": "25 (fast)"},
        {"value": "50", "label": "50"},
        {"value": "100", "label": "100 (slow)"}
      ],
      "args": ["--ddim_steps", "{value}"]
    },
    {
      "id": "guidance",
      "name": "Guidance",
      "type": "choice",
      "default": "3.5",
      "description": "How strongly the model adds high frequencies. Higher is brighter and can sound artificial.",
      "choices": [
        {"value": "2.5", "label": "2.5"},
        {"value": "3.5", "label": "3.5"},
        {"value": "5", "label": "5"}
      ],
      "args": ["-gs", "{value}"]
    }
  ]
}
