{
  "id": "realcugan-ncnn",
  "name": "Real-CUGAN",
  "vendor": "Bilibili AI Lab",
  "description": "Cascaded U-Net trained on anime. Sharp line art with adjustable denoising, from conservative to aggressive.",
  "homepage": "https://github.com/nihui/realcugan-ncnn-vulkan",
  "license": "MIT",
  "tags": ["CNN", "Anime"],
  "requirements": "Any GPU with Vulkan",
  "media": ["image", "video"],
  "input": "image",
  "batch": true,
  "install": {
    "type": "archive",
    "size": "30 MB",
    "urls": {
      "linux": "https://github.com/nihui/realcugan-ncnn-vulkan/releases/download/20220728/realcugan-ncnn-vulkan-20220728-ubuntu.zip",
      "windows": "https://github.com/nihui/realcugan-ncnn-vulkan/releases/download/20220728/realcugan-ncnn-vulkan-20220728-windows.zip",
      "darwin": "https://github.com/nihui/realcugan-ncnn-vulkan/releases/download/20220728/realcugan-ncnn-vulkan-20220728-macos.zip"
    }
  },
  "executable": {"windows": "realcugan-ncnn-vulkan.exe", "*": "realcugan-ncnn-vulkan"},
  "args": ["-i", "{input}", "-o", "{output}", "-s", "{scale}", "{modelArgs}", "-f", "png"],
  "gpuArgs": ["-g", "{gpu}"],
  "outputExt": ".png",
  "scales": [2, 3, 4],
  "defaultScale": 2,
  "models": [
    {"id": "se-conservative", "name": "SE · Conservative", "description": "Keeps the most original texture.", "args": ["-m", "models-se", "-n", "-1"]},
    {"id": "se-no-denoise", "name": "SE · No denoise", "description": "Upscales without cleaning.", "args": ["-m", "models-se", "-n", "0"]},
    {"id": "se-denoise3x", "name": "SE · Strong denoise", "description": "For noisy or heavily compressed sources.", "args": ["-m", "models-se", "-n", "3"]},
    {"id": "pro-conservative", "name": "Pro · Conservative", "description": "Newer weights, finer detail.", "args": ["-m", "models-pro", "-n", "-1"], "scales": [2, 3]},
    {"id": "pro-denoise3x", "name": "Pro · Strong denoise", "description": "Newer weights with strong cleaning.", "args": ["-m", "models-pro", "-n", "3"], "scales": [2, 3]}
  ],
  "options": [
    {
      "id": "tile",
      "name": "Tile size",
      "type": "choice",
      "default": "0",
      "description": "Pictures are upscaled in tiles of this size. Automatic picks one from the GPU's memory; smaller tiles fit small GPUs, bigger ones are faster.",
      "choices": [
        {"value": "0", "label": "Automatic"},
        {"value": "32", "label": "32 px"},
        {"value": "64", "label": "64 px"},
        {"value": "128", "label": "128 px"},
        {"value": "256", "label": "256 px"},
        {"value": "512", "label": "512 px"}
      ],
      "args": ["-t", "{value}"]
    },
    {
      "id": "threads",
      "name": "Threads",
      "type": "choice",
      "default": "1:2:2",
      "description": "Threads that load, upscale and save frames. More keep the GPU busy on fast GPUs when TouchUp feeds it a whole video.",
      "choices": [
        {"value": "1:2:2", "label": "1 · 2 · 2 (light)"},
        {"value": "2:2:4", "label": "2 · 2 · 4"},
        {"value": "2:4:4", "label": "2 · 4 · 4"},
        {"value": "4:4:8", "label": "4 · 4 · 8 (fast GPUs)"}
      ],
      "args": ["-j", "{value}"]
    },
    {
      "id": "syncgap",
      "name": "Tile sync",
      "type": "choice",
      "default": "3",
      "description": "How tiles agree on what they see. Off is fastest and can show tile edges; accurate is slowest.",
      "choices": [
        {"value": "0", "label": "Off (fastest)"},
        {"value": "1", "label": "Accurate (slowest)"},
        {"value": "2", "label": "Rough"},
        {"value": "3", "label": "Very rough"}
      ],
      "args": ["-c", "{value}"]
    },
    {
      "id": "tta",
      "name": "Test-time augmentation",
      "type": "toggle",
      "default": "false",
      "description": "Upscale eight flipped and rotated copies and average them: slightly cleaner, eight times slower.",
      "args": ["-x"]
    }
  ]
}
