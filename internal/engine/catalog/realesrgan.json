{
  "id": "realesrgan-ncnn",
  "name": "Real-ESRGAN",
  "vendor": "Xintao Wang · Tencent ARC",
  "description": "The workhorse for real-world photos and video: restores detail while removing blur, noise and compression artifacts. Includes a fast model trained for anime video.",
  "homepage": "https://github.com/xinntao/Real-ESRGAN",
  "license": "BSD-3-Clause",
  "tags": ["GAN", "Photo", "Anime"],
  "requirements": "Any GPU with Vulkan (NVIDIA, AMD, Intel, Apple)",
  "media": ["image", "video"],
  "input": "image",
  "batch": true,
  "install": {
    "type": "archive",
    "size": "45 MB",
    "urls": {
      "linux": "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesrgan-ncnn-vulkan-20220424-ubuntu.zip",
      "windows": "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesrgan-ncnn-vulkan-20220424-windows.zip",
      "darwin": "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesrgan-ncnn-vulkan-20220424-macos.zip"
    }
  },
  "executable": {"windows": "realesrgan-ncnn-vulkan.exe", "*": "realesrgan-ncnn-vulkan"},
  "args": ["-i", "{input}", "-o", "{output}", "-s", "{scale}", "{modelArgs}", "-f", "png"],
  "gpuArgs": ["-g", "{gpu}"],
  "outputExt": ".png",
  "scales": [4],
  "defaultScale": 4,
  "models": [
    {"id": "realesrgan-x4plus", "name": "General · x4plus", "description": "Photos and live-action footage.", "args": ["-n", "realesrgan-x4plus"], "scales": [4]},
    {"id": "realesrgan-x4plus-anime", "name": "Anime · x4plus", "description": "Illustrations and anime stills.", "args": ["-n", "realesrgan-x4plus-anime"], "scales": [4]},
    {"id": "realesr-animevideov3", "name": "Anime video · v3", "description": "Small and fast, made for animated video.", "args": ["-n", "realesr-animevideov3"], "scales": [2, 3, 4]}
  ],
  "options": [
    {
      "id": "tile",
      "name": "Tile size",
      "type": "choice",
      "default": "0",
      "description": "Pictures are upscaled in tiles of this size. Automatic picks one from the GPU's memory; smaller tiles fit small GPUs, bigger ones are faster.",
      "choices": [
        {"value": "0", "label": "Automatic"},
        {"value": "32", "label": "32 px"},
        {"value": "64", "label": "64 px"},
        {"value": "128", "label": "128 px"},
        {"value": "256", "label": "256 px"},
        {"value": "512", "label": "512 px"}
      ],
      "args": ["-t", "{value}"]
    },
    {
      "id": "threads",
      "name": "Threads",
      "type": "choice",
      "default": "1:2:2",
      "description": "Threads that load, upscale and save frames. More keep the GPU busy on fast GPUs when TouchUp feeds it a whole video.",
      "choices": [
        {"value": "1:2:2", "label": "1 · 2 · 2 (light)"},
        {"value": "2:2:4", "label": "2 · 2 · 4"},
        {"value": "2:4:4", "label": "2 · 4 · 4"},
        {"value": "4:4:8", "label": "4 · 4 · 8 (fast GPUs)"}
      ],
      "args": ["-j", "{value}"]
    },
    {
      "id": "tta",
      "name": "Test-time augmentation",
      "type": "toggle",
      "default": "false",
      "description": "Upscale eight flipped and rotated copies and average them: slightly cleaner, eight times slower.",
      "args": ["-x"]
    }
  ]
}
