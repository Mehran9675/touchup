{
  "id": "spandrel",
  "name": "PyTorch SR",
  "featured": true,
  "vendor": "spandrel · community models",
  "description": "Runs the strongest community image models (DRCT, DAT, ATD, RealPLKSR, SwinIR, Real-ESRGAN) on your GPU. Install only the models you want.",
  "homepage": "https://github.com/chaiNNer-org/spandrel",
  "license": "MIT · models vary",
  "tags": ["Transformer", "GAN", "Photo", "Anime", "PyTorch"],
  "requirements": "Python 3.10+ · NVIDIA GPU recommended; Apple Silicon and CPU work, slowly",
  "media": ["image", "video"],
  "input": "image",
  "batch": true,
  "install": {
    "type": "pip",
    "size": "≈ 3 GB with PyTorch, plus models",
    "scripts": ["spandrel_runner.py"],
    "pip": [
      {
        "args": ["torch>=2.7", "torchvision"],
        "indexURL": {"windows": "https://download.pytorch.org/whl/cu128"}
      },
      {"args": ["spandrel", "spandrel_extra_arches", "pillow", "numpy"]}
    ]
  },
  "executable": {"*": "python"},
  "args": [
    "{engineDir}/spandrel_runner.py",
    "--model",
    "{modelPath}",
    "--input",
    "{input}",
    "--output",
    "{output}",
    "--scale",
    "{scale}"
  ],
  "gpuArgs": ["--gpu", "{gpu}"],
  "outputExt": ".png",
  "scales": [2, 3, 4],
  "defaultScale": 4,
