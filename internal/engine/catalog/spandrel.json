  "options": [
    {
      "id": "tile",
      "name": "Tile size",
      "type": "choice",
      "default": "768",
      "description": "Pictures larger than this are upscaled in overlapping tiles. Bigger is faster and lets whole video frames go in batches, but needs more GPU memory; when it runs out, TouchUp halves the tiles and carries on.",
      "choices": [
        {"value": "256", "label": "256 px"},
        {"value": "384", "label": "384 px"},
        {"value": "512", "label": "512 px"},
        {"value": "768", "label": "768 px"},
        {"value": "1024", "label": "1024 px"},
        {"value": "1536", "label": "1536 px"},
        {"value": "0", "label": "Whole picture"}
      ],
      "args": ["--tile", "{value}"]
    },
    {
      "id": "batch",
      "name": "Frames per pass",
      "type": "choice",
      "default": "4",
      "description": "Video frames that fit in one tile go through the model this many at a time, which keeps the GPU busy with small, fast models. Halves itself when the GPU runs out of memory.",
      "choices": [
        {"value": "1", "label": "1"},
        {"value": "2", "label": "2"},
        {"value": "4", "label": "4"},
        {"value": "8", "label": "8"},
        {"value": "16", "label": "16"}
      ],
      "args": ["--batch", "{value}"]
    },
    {
      "id": "precision",
      "name": "Precision",
      "type": "choice",
      "default": "auto",
      "description": "Automatic uses half precision, or bfloat16 for models that overflow in half, and falls back to full precision when the GPU fails.",
      "choices": [
        {"value": "auto", "label": "Automatic"},
        {"value": "half", "label": "Half (fastest)"},
        {"value": "bfloat16", "label": "bfloat16"},
        {"value": "full", "label": "Full (slowest)"}
      ],
      "args": ["--precision", "{value}"]
    },
    {
      "id": "colorFix",
      "name": "Keep the original colors",
      "type": "toggle",
      "default": "true",
      "description": "Take colors from the original and detail from the model, for models that drift on saturated hues.",
      "argsOff": ["--no-color-fix"]
    }
  ]
}
