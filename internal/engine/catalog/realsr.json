{
  "id": "realsr-ncnn",
  "name": "RealSR",
  "vendor": "Tencent Youtu Lab",
  "description": "Real-world super-resolution through kernel estimation. Natural-looking 4x photos without the painted look of heavier GANs.",
  "homepage": "https://github.com/nihui/realsr-ncnn-vulkan",
  "license": "MIT",
  "tags": ["Photo"],
  "requirements": "Any GPU with Vulkan",
  "media": ["image", "video"],
  "input": "image",
  "batch": true,
  "install": {
    "type": "archive",
    "size": "20 MB",
    "urls": {
      "linux": "https://github.com/nihui/realsr-ncnn-vulkan/releases/download/20220728/realsr-ncnn-vulkan-20220728-ubuntu.zip",
      "windows": "https://github.com/nihui/realsr-ncnn-vulkan/releases/download/20220728/realsr-ncnn-vulkan-20220728-windows.zip",
      "darwin": "https://github.com/nihui/realsr-ncnn-vulkan/releases/download/20220728/realsr-ncnn-vulkan-20220728-macos.zip"
    }
  },
  "executable": {"windows": "realsr-ncnn-vulkan.exe", "*": "realsr-ncnn-vulkan"},
  "args": ["-i", "{input}", "-o", "{output}", "-s", "{scale}", "{modelArgs}", "-f", "png"],
  "gpuArgs": ["-g", "{gpu}"],
  "outputExt": ".png",
  "scales": [4],
  "defaultScale": 4,
  "models": [
    {"id": "df2k", "name": "DF2K", "description": "Clean photos.", "args": ["-m", "models-DF2K"]},
    {"id": "df2k-jpeg", "name": "DF2K · JPEG", "description": "Photos with JPEG artifacts.", "args": ["-m", "models-DF2K_JPEG"]}
  ],
  "options": [
    {
      "id": "tile",
      "name": "Tile size",
      "type": "choice",
      "default": "0",
      "description": "Pictures are upscaled in tiles of this size. Automatic picks one from the GPU's memory; smaller tiles fit small GPUs, bigger ones are faster.",
      "choices": [
        {"value": "0", "label": "Automatic"},
        {"value": "32", "label": "32 px"},
        {"value": "64", "label": "64 px"},
        {"value": "128", "label": "128 px"},
        {"value": "256", "label": "256 px"},
        {"value": "512", "label": "512 px"}
      ],
      "args": ["-t", "{value}"]
    },
    {
      "id": "threads",
      "name": "Threads",
      "type": "choice",
      "default": "1:2:2",
      "description": "Threads that load, upscale and save frames. More keep the GPU busy on fast GPUs when TouchUp feeds it a whole video.",
      "choices": [
        {"value": "1:2:2", "label": "1 · 2 · 2 (light)"},
        {"value": "2:2:4", "label": "2 · 2 · 4"},
        {"value": "2:4:4", "label": "2 · 4 · 4"},
        {"value": "4:4:8", "label": "4 · 4 · 8 (fast GPUs)"}
      ],
      "args": ["-j", "{value}"]
    },
    {
      "id": "tta",
      "name": "Test-time augmentation",
      "type": "toggle",
      "default": "false",
      "description": "Upscale eight flipped and rotated copies and average them: slightly cleaner, eight times slower.",
      "args": ["-x"]
    }
  ]
}
